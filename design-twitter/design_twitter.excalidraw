    {
      "id": "Enr0KOZW968o0qI5xoh_w",
      "type": "text",
      "x": 144.1500015258789,
      "y": 416.6499357223511,
      "width": 1415.899169921875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1495972702,
      "version": 1708,
      "versionNonce": 1924471500,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789657406279,
      "link": null,
      "locked": false,
      "text": "-> DB and Cache on the notification service supports storing notification templates. The DB also stores client info and device tokens\nand wont send notifications if the user opted out.\n-> Frequently used templates are stored in Cache for faster Retrieval.\n-> Rate Limiters and Authentication service are implemented inside the Notification service based on user preferences to not overflow\nusers with notifications. Eg: 10 Notification per day\n-> We will be running multiple queues with multiple workers for each channel. Eg: iOS will have its own queue and a worker. \n-> Based on the user's enabled channels, a single notification will be delivered across all channels.\nIf a notification fails, the Worker sends the notification back to the Queue for a retry. We can have N number of retries and if the notification\nstill fails, we can remove them from the queue and report back to the service for manual inspection.\n-> The Workers are connected to a Notification Log DB to track all the notifications that have been sent. This ensures idempotency.\n-> An Analytics Service can be used to track the notifications that have been clicked or sent to spam by the users.\n-> Mail: MailChimp, SMS: Twilio, iOS: APN, Android: Firebase",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> DB and Cache on the notification service supports storing notification templates. The DB also stores client info and device tokens\nand wont send notifications if the user opted out.\n-> Frequently used templates are stored in Cache for faster Retrieval.\n-> Rate Limiters and Authentication service are implemented inside the Notification service based on user preferences to not overflow\nusers with notifications. Eg: 10 Notification per day\n-> We will be running multiple queues with multiple workers for each channel. Eg: iOS will have its own queue and a worker. \n-> Based on the user's enabled channels, a single notification will be delivered across all channels.\nIf a notification fails, the Worker sends the notification back to the Queue for a retry. We can have N number of retries and if the notification\nstill fails, we can remove them from the queue and report back to the service for manual inspection.\n-> The Workers are connected to a Notification Log DB to track all the notifications that have been sent. This ensures idempotency.\n-> An Analytics Service can be used to track the notifications that have been clicked or sent to spam by the users.\n-> Mail: MailChimp, SMS: Twilio, iOS: APN, Android: Firebase",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
