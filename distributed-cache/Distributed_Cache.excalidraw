    {
      "id": "q-YxX03vG1P3ddlc4Rbeg",
      "type": "text",
      "x": 118.22218831380269,
      "y": 1159.519051506406,
      "width": 1399.3397216796875,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Z",
      "roundness": null,
      "seed": 2103286247,
      "version": 663,
      "versionNonce": 156783143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788467880238,
      "link": null,
      "locked": false,
      "text": "-> We will Cache Aside architecture for the problem.\n-> Each cache shard in the Consistent Hashing has a replica.\n-> Each physical cache maps to multiple virtual nodes in consistent hashing\nfor smooth load distribution.\n-> We will be using LRU eviction as it is the most common and practically sound.\n-> If the total data is 100GB, we need to design a cache for 20GB as per\n80/20 cache access pattern.\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> We will Cache Aside architecture for the problem.\n-> Each cache shard in the Consistent Hashing has a replica.\n-> Each physical cache maps to multiple virtual nodes in consistent hashing\nfor smooth load distribution.\n-> We will be using LRU eviction as it is the most common and practically sound.\n-> If the total data is 100GB, we need to design a cache for 20GB as per 80/20 cache access pattern.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
