      "isDeleted": false,
      "boundElements": null,
      "updated": 1788467964085,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n\n-> Faster reads \n-> Evict when the cache is full",
      "fontSize": 29.920007324218744,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n-> Faster reads \n-> Evict when the cache is full",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
