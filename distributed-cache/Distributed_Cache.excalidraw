    {
      "id": "eJWq3AtQxUw3oj2suwurN",
      "type": "text",
      "x": 347.20001220703125,
      "y": 113.9000244140625,
      "width": 679.195917929709,
      "height": 73.79998779296875,
      "angle": 0,
      "strokeColor": "#f08c00",
