    {
      "id": "hIaITA4wRNCXAOFSHg4js",
      "type": "text",
      "x": 1235.2000122070312,
      "y": 434.1000061035156,
      "width": 135.00632995605469,
      "height": 38,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
