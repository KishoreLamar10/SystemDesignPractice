      "boundElements": [],
      "updated": 1788269276654,
      "link": null,
      "locked": false,
      "text": "100 Million Daily \nusers per day DAU\n\n1 Billion reads per day\n10K Reads per second\n\n5Billion Total \nLifetime URLS\n\nShort URL is 6 characters\n62 characters a-z A-Z 0-9 per \ncharacter gives us 56B URLS",
      "fontSize": 40.53751083460374,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "100 Million Daily \nusers per day DAU\n\n1 Billion reads per day\n10K Reads per second\n\n5Billion Total \nLifetime URLS\n\nShort URL is 6 characters\n62 characters a-z A-Z 0-9 per \ncharacter gives us 56B URLS",
      "autoResize": true,
      "lineHeight": 1.25
