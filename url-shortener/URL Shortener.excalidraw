      "updated": 1787865229053,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n\n-> Shorten URL - Convert long URLs into shorter URLs\n-> Redirect shorter URL to Original URL\n-> URL Expiration - URL should be expired \nafter a period of time\n-> Analytics - Track click counts\n",
      "fontSize": 34.17598963979997,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n-> Shorten URL - Convert long URLs into shorter URLs\n-> Redirect shorter URL to Original URL\n-> URL Expiration - URL should be expired \nafter a period of time\n-> Analytics - Track click counts\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
